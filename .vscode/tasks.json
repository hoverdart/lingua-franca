{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lingua Franca: Run Main (.venv)",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "-c",
        "source .venv/bin/activate && lfc src/Main.lf && ./bin/Main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
